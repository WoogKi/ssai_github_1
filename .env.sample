# ============================================
# SIMS AI / LM Studio .env.sample
# 실제 비밀번호와 운영 접속정보는 .env 파일에만 입력합니다.
# 이 파일은 Git에 포함 가능한 예시 파일입니다.
# ============================================

# -------------------------
# 1) 기본 환경
# -------------------------
APP_ENV=dev
APP_LOG_LEVEL=DEBUG
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# -------------------------
# 2) LM Studio / OpenAI Compatible API
# -------------------------
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=google/gemma-3-27b

OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio

LLM_TIMEOUT_S=90
LLM_MAX_RETRY=1
LLM_BACKOFF_SEQ=0.6,1.2,2.0

# -------------------------
# 3) MSSQL / SIMS DB 예시
# 실제 운영값은 .env에만 입력합니다.
# -------------------------
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_SERVER=YOUR_DB_SERVER,1433
MSSQL_DATABASE=YOUR_SIMS_DB
MSSQL_UID=YOUR_DB_USER
MSSQL_PWD=YOUR_DB_PASSWORD

MSSQL_ENCRYPT=yes
MSSQL_TRUST=yes
MSSQL_TIMEOUT=15
MSSQL_MARS=yes

MSSQL_CHARSET=cp949
MSSQL_WCHARSET=utf-16le
MSSQL_CLIENT_ENCODING=utf-8

# -------------------------
# 4) SIMS 조회 옵션
# -------------------------
SIMS_LIMIT_STYLE=top
SIMS_DEFAULT_LIMIT=300
SIMS_DISPLAY_TOP=1000
SIMS_MAX_CSV_ROWS=12000
SIMS_CODE_CACHE_TTL_S=300

SIMS_LOG_LEVEL=INFO
SIMS_DEBUG_SQL=0
SQL_ECHO=no

# -------------------------
# 5) 채팅 / 업로드 경로
# -------------------------
CHAT_FILE=data/chat_rooms.json
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
MAX_PREVIEW_CHARS=4000

# -------------------------
# 6) Debug
# -------------------------
DEBUG_MODE=false
